# Copy to .env (setup.sh does this automatically). .env is gitignored because
# it ends up holding this host's UID/GID and is treated as environment-specific.

# --- Docker network (kept off common Docker Desktop / VPN ranges) ---
NETWORK_SUBNET=10.253.53.0/24
OPENBAO_IP=10.253.53.10
BIND9_IP=10.253.53.20
PEBBLE_IP=10.253.53.30
NGINX_IP=10.253.53.40

# --- Host identity, used so BIND (and any other container that must write to
# a bind-mounted host directory) runs as this user instead of root/a container
# UID that doesn't exist on the host. Overwritten by setup.sh on every run. ---
HOST_UID=1000
HOST_GID=1000

# --- Domains / ACME ---
ZONE=lab.test
DOMAINS=lab.test,*.lab.test
ACME_SERVER=https://localhost:14000/dir
ACME_EMAIL=lab-admin@lab.test

# --- OpenBao ---
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_ROOT_TOKEN=root
SECRET_PATH=secret/dns/lab

# --- DNS provider abstraction (production-portable) ---
# DNS_PLUGIN selects which certbot DNS plugin + credential shape fetch-secret.sh
# renders. In production this becomes DNS_PLUGIN=cloudflare with a Cloudflare
# API token stored at SECRET_PATH instead of a TSIG key.
DNS_PLUGIN=rfc2136
# Non-secret RFC2136 connection info (the TSIG key/secret itself lives in
# OpenBao, mirroring how a Cloudflare API token would be the only secret).
DNS_RFC2136_SERVER=127.0.0.1
DNS_RFC2136_PORT=5353

# --- Pebble tunables (see letsencrypt/pebble README) ---
# PEBBLE_VA_NOSLEEP=1 skips Pebble's artificial validation delay.
# Set PEBBLE_WFE_NONCEREJECT back to a positive number (e.g. 5) to make Pebble
# reject the first N nonces and exercise Certbot's retry logic.
PEBBLE_VA_NOSLEEP=1
PEBBLE_WFE_NONCEREJECT=0

# --- Cert deployment (production-portable) ---
CERT_DEST_DIR=./nginx/certs
# In production these become `nginx -t` / `systemctl reload nginx` directly.
NGINX_TEST_CMD="docker compose exec -T nginx nginx -t"
NGINX_RELOAD_CMD="docker compose exec -T nginx nginx -s reload"
