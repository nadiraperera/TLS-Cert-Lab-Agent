$TTL 300
@       IN  SOA  ns1.lab.test. admin.lab.test. (
                 2024010100  ; serial -- BIND bumps this itself on dynamic updates
                 3600        ; refresh
                 900         ; retry
                 604800      ; expire
                 300 )       ; negative cache TTL

        IN  NS   ns1.lab.test.

ns1     IN  A    __BIND9_IP__
@       IN  A    __NGINX_IP__
*       IN  A    __NGINX_IP__
