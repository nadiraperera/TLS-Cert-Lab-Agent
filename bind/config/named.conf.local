// Generated by tsig-keygen (scripts/setup.sh), mounted read-only at this path.
include "/etc/bind/keys/certbot-key.key";

zone "lab.test" {
    type master;
    file "/var/cache/bind/db.lab.test";

    // Least-privilege equivalent of a scoped Cloudflare API token: this key
    // may only create/update/delete the TXT RRset at the exact ACME
    // challenge name, nothing else in the zone (use update-policy, not the
    // coarser allow-update).
    update-policy {
        grant certbot-key name _acme-challenge.lab.test TXT;
    };
};
